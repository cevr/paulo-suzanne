# Worker secrets, read by `bun run deploy` and by the dev server.
ADMIN_PASSWORD=
COOKIE_SECRET=

# Dev server only: serve the bundled defaults when `.data/bucket` has no
# content/site.json. The deployed Worker never reads it, so a missing or broken
# site.json fails the request instead of shipping defaults.
ALLOW_DEFAULT_CONTENT=

# Dev server only: its port (3000).
PORT=
