NODE_ENV=development
PORT=3000

BUCKET_ENDPOINT=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_NAME=
BUCKET_REGION=auto

ADMIN_PASSWORD=
COOKIE_SECRET=

# Build-time content fallback.
# Set to 1 ONLY for dev or first-deploy bootstrap (no content/site.json in
# bucket yet). In prod, leave UNSET so a missing bucket/key/decode failure
# fails the build instead of silently shipping defaults.
ALLOW_DEFAULT_CONTENT=

# Railway redeploy trigger (admin Publish). Optional — without these, admin
# saves to bucket only.
RAILWAY_API_TOKEN=
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=
