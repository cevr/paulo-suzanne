{
  "name": "paulo-suzanne",
  "private": true,
  "type": "module",
  "imports": {
    "#server-build": {
      "types": "./src/server/server-build.d.ts",
      "default": "./build/server/index.js"
    }
  },
  "scripts": {
    "dev": "bun --hot ./server.ts",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test app/ src/ tests/",
    "gate": "concurrently -n type,style,build -c blue,yellow,cyan \"bun run typecheck\" \"bun run lint && bun run fmt\" \"bun run build\" && bun run test",
    "plan": "react-router build && alchemy plan alchemy.run.ts --stage prod",
    "deploy": "react-router build && alchemy deploy alchemy.run.ts --stage prod",
    "test:deploy": "react-router build && bun test ./tests/deploy.integration.ts",
    "prepare": "(test -d .git && lefthook install || true) && effect-tsgo patch"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "class-variance-authority": "^0.7.1",
    "effect": "4.1.2",
    "isbot": "5.2.2",
    "lucide-react": "^1.35.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/test": "2.0.0-beta.85",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@effect/tsgo": "0.64.1",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.4.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "alchemy": "2.0.0-beta.85",
    "concurrently": "10.0.6",
    "effect-bun-test": "0.4.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-plugin-effect": "0.31.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "packageManager": "bun@1.4.0"
}
