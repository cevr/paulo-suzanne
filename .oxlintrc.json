{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "jsPlugins": ["./lint/no-promise-control-flow-in-tests.ts"],
  "rules": {
    "paulo-suzanne/no-promise-control-flow-in-tests": "error"
